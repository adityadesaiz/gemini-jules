// prisma/schema.prisma

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model AdaptiveFormMemory {
  id                 String   @id @default(cuid())
  fieldLabelSemantic String   @unique
  userResponse       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AppFunnelEntry {
  id                 String   @id @default(cuid())
  fieldCharacteristics Json
  status             String   @default("stuck") // e.g., 'stuck', 'approved'
  triggeredAt        DateTime @default(now())
}
